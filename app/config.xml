<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/hotzenplotz5/vdr-suite-samsung"
        version="0.1.0"
        viewmodes="maximized">
  <tizen:application id="VDRSuiteTV.VDRSuite"
                     package="VDRSuiteTV"
                     required_version="5.5"/>
  <content src="index.html"/>
  <name>VDR-Suite</name>
  <description>VDR-Suite Samsung TV Client</description>
  <icon src="assets/icon.png"/>
  <!-- S3.1 user-configured HTTPS server: broad manifest access, strict runtime URL validation. -->
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="5.5"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
